{
  "name": "@liveblocks/react-tiptap",
  "version": "3.11.0",
  "description": "An integration of TipTap + React to enable collaboration, comments, live cursors, and more with Liveblocks.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": {
      "types": "./styles.css.d.cts",
      "default": "./src/styles/index.css"
    }
  },
  "files": [
    "dist/**",
    "**/*.css",
    "**/*.css.d.cts",
    "**/*.css.d.ts",
    "**/*.css.map",
    "README.md"
  ],
  "scripts": {
    "dev": "rollup --config rollup.config.js --watch",
    "build": "rollup --config rollup.config.js",
    "format": "eslint --fix src/; stylelint --fix src/styles/; prettier --write src/",
    "lint": "eslint src/; stylelint src/styles/",
    "lint:package": "publint --strict && attw --pack",
    "start": "npm run dev",
    "test": "NODE_OPTIONS=\"--no-deprecation\" vitest run",
    "test:watch": "NODE_OPTIONS=\"--no-deprecation\" vitest"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.2",
    "@liveblocks/client": "workspace:*",
    "@liveblocks/core": "workspace:*",
    "@liveblocks/react": "workspace:*",
    "@liveblocks/react-ui": "workspace:*",
    "@liveblocks/yjs": "workspace:*",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-toggle": "^1.1.0",
    "@tiptap/core": "^3.8.0",
    "@tiptap/react": "^3.8.0",
    "@tiptap/suggestion": "^3.8.0",
    "cmdk": "^1.0.4",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.18"
  },
  "peerDependencies": {
    "@tiptap/extension-collaboration": "^3.8.0",
    "@tiptap/extension-collaboration-caret": "^3.8.0",
    "@tiptap/pm": "^3.8.0",
    "@tiptap/react": "^3.8.0",
    "@tiptap/suggestion": "^3.8.0",
    "@types/react": "*",
    "@types/react-dom": "*",
    "react": "^18 || ^19 || ^19.0.0-rc",
    "react-dom": "^18 || ^19 || ^19.0.0-rc"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@liveblocks/eslint-config": "workspace:*",
    "@liveblocks/rollup-config": "workspace:*",
    "@liveblocks/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "^5.16.5",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "msw": "^2.10.4",
    "stylelint": "^15.10.2",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-order": "^6.0.3",
    "stylelint-plugin-logical-css": "^0.13.2"
  },
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/liveblocks/liveblocks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liveblocks/liveblocks.git",
    "directory": "packages/liveblocks-react-tiptap"
  },
  "homepage": "https://liveblocks.io",
  "keywords": [
    "tiptap",
    "react",
    "comments",
    "threads",
    "liveblocks",
    "real-time",
    "toolkit",
    "multiplayer",
    "websockets",
    "collaboration",
    "collaborative",
    "presence",
    "crdts",
    "synchronize",
    "rooms",
    "documents",
    "conflict resolution"
  ]
}
